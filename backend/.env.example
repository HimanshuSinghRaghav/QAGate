# ---- Database ----
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5433/qa_gate

# ---- OpenRouter (semantic layer only) ----
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45

# ---- Scoring policy ----
# Any check landing below this confidence is routed to QA instead of auto-passing.
CONFIDENCE_THRESHOLD=0.80
# Percentage of otherwise-clean calls sampled to a human auditor.
HUMAN_SAMPLE_RATE=0.05
# Deterministic sampling makes the demo reproducible (hash of lead id, not random).
DETERMINISTIC_SAMPLING=true

# ---- Transcript timing ----
# Words per second used to estimate timestamps when ASR word timings are absent.
ESTIMATED_WORDS_PER_SECOND=2.6

# ---- ElevenLabs (demo call audio only) ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional. python scripts/generate_demo_audio.py --list-voices
# ELEVENLABS_HELEN_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_MARCO_VOICE_ID=pNInz6obpgDQGcFmaJgB
